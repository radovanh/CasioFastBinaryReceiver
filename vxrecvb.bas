866 IF K=6 THEN PRINT "serial";PEEK(Q+18);"-PC";B;"8N1?";
867 IF K=5 THEN PRINT "RXBIN DATA damaged";
868 IF K=7 THEN PRINT "stopped (BRK)";
869 IF K=8 THEN PRINT "buffer full";
870 IF L>0 AND K>5 THEN LOCATE 0,1:PRINT N-L;"of";N;"bytes";
875 LOCATE 0,2:END
900 'BASIC error: report without building strings
910 K=ERR:J=ERL:CLOSE:BEEP 1:CLS
920 PRINT "ERR BASIC";K;"line";J;:LOCATE 0,1
925 IF K=1 THEN PRINT "OM: out of memory";
930 IF K=5 THEN PRINT "BV: buffer full-XON/XOFF on?";
940 IF K=30 THEN PRINT "FR: PC must be 4800 8N1";
